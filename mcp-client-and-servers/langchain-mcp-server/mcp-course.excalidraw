      "isDeleted": false,
      "boundElements": [],
      "updated": 1775722691509,
      "link": null,
      "locked": false,
      "text": "3. Client features \n\nEnables servers to ask the client to sample from the host LLM,\n elicit input from the user, and log messages to the client",
      "fontSize": 39.78884538810454,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Client features \n\nEnables servers to ask the client to sample from the host LLM,\n elicit input from the user, and log messages to the client",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "14VySIT307ysPxEhoDhUA",
      "type": "text",
      "x": -611.8533657743474,
      "y": 13563.129609280439,
      "width": 1303.8685302734375,
      "height": 198.9442269405227,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3A",
      "roundness": null,
      "seed": 812800913,
      "version": 849,
      "versionNonce": 1906942591,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775722691509,
      "link": null,
      "locked": false,
      "text": "4. Utility features \n\nSupports additional capabilities like notifications for \nreal-time updates and progress tracking for long-running operations",
      "fontSize": 39.78884538810454,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Utility features \n\nSupports additional capabilities like notifications for \nreal-time updates and progress tracking for long-running operations",
