      "seed": 1582912575,
      "version": 524,
      "versionNonce": 1407417361,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775722655201,
      "link": null,
      "locked": false,
      "text": "The data layer implements a JSON-RPC 2.0 based exchange protocol\nthat defines the message structure and semantics. \n\nThis layer includes:",
      "fontSize": 51.327998297134734,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The data layer implements a JSON-RPC 2.0 based exchange protocol that defines the message structure and semantics. \n\nThis layer includes:",
      "autoResize": false,
      "lineHeight": 1.25
    },
