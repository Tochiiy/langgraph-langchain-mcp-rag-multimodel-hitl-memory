    },
    {
      "id": "lSqWaSl9jTK16v86DhHG8",
      "type": "text",
      "x": -421.8231636323526,
      "y": 11435.729459569564,
      "width": 1183.45458984375,
      "height": 248.68028367565336,
      "angle": 0,
      "strokeColor": "#1e1e1e",
