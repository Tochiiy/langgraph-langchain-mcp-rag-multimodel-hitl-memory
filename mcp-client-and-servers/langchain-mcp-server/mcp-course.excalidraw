      "boundElements": [
        {
          "id": "0eSqjv831NqhxAs185Wlo",
          "type": "arrow"
        }
      ],
      "updated": 1775722655201,
      "link": null,
      "locked": false,
      "text": "2. Server features \n\nEnables servers to provide core functionality including tools \nfor AI actions, resources for context data, and prompts for\n interaction templates to the client",
      "fontSize": 39.78884538810454,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Server features \n\nEnables servers to provide core functionality including tools \nfor AI actions, resources for context data, and prompts for\n interaction templates to the client",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "p8Jaz446RO7srjCkv8oFw",
      "type": "text",
      "x": -482.7351331372247,
      "y": 8031.983801101309,
      "width": 1828.704998308823,
      "height": 256.63999148567365,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
