      "version": 554,
      "versionNonce": 450411967,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775722630782,
      "link": null,
      "locked": false,
      "text": "II.1.1 Transport layer",
      "fontSize": 70.35459865003068,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "II.1.1 Transport layer",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4Q7xDvLJh2gYXifpULldf",
      "type": "text",
      "x": -385.6012444994194,
      "y": 4991.880815954977,
      "width": 760.2117919921875,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0j",
      "roundness": null,
      "seed": 673638705,
      "version": 470,
      "versionNonce": 966307295,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775722630782,
      "link": null,
      "locked": false,
      "text": "MCP supports two transports mechanisms :",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MCP supports two transports mechanisms :",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Ttr7TMyglGV1RclOYH-b4",
      "type": "text",
      "x": -370.313504245285,
      "y": 5387.632361256445,
      "width": 1238.3638916015625,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0k",
      "roundness": null,
      "seed": 1253350161,
      "version": 468,
      "versionNonce": 925211135,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775722630782,
      "link": null,
      "locked": false,
      "text": "1. Stdio transport \n\nUses standard input/output streams for direct process\n communication between local processes on the same machine, providing\n optimal performance with no network overhead.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Stdio transport \n\nUses standard input/output streams for direct process\n communication between local processes on the same machine, providing\n optimal performance with no network overhead.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y_YOr_WQ1vkWY3Ab1u9Jn",
      "type": "text",
      "x": -396.12129203069344,
      "y": 6689.260871892373,
      "width": 1290.9957275390625,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0l",
      "roundness": null,
      "seed": 410063089,
      "version": 358,
      "versionNonce": 679477791,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775722630782,
      "link": null,
      "locked": false,
      "text": "2. Streamable HTTP transport\n\nUses Http POST for client-to-server messages with optional Server-Sent\n Events for streaming capabilities.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Streamable HTTP transport\n\nUses Http POST for client-to-server messages with optional Server-Sent\n Events for streaming capabilities.",
      "autoResize": true,
      "lineHeight": 1.25
    },
