      "updated": 1775722630782,
      "link": null,
      "locked": false,
      "text": "II.1. Transport layer\n\nHandles the physical connection, streaming, and message delivery\n (eg: stdio, HTTP + SSE or websockets)",
      "fontSize": 49.872923153059105,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "II.1. Transport layer\n\nHandles the physical connection, streaming, and message delivery\n (eg: stdio, HTTP + SSE or websockets)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "r2p62j6RULG6MQgIGFDsm",
      "type": "text",
      "x": -466.9076530780221,
      "y": 4358.877166677012,
      "width": 2134.7705078125,
      "height": 278.40102093147584,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0h",
      "roundness": null,
      "seed": 164221297,
      "version": 1018,
      "versionNonce": 265636255,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775722630782,
      "link": null,
      "locked": false,
      "text": "II.2. Data Acess layer \n\nDefines the JSON-RPC 2 semantic, defining the structure of tools, resources \nand prompts as well as the lifecycle and session",
      "fontSize": 55.68020418629517,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "II.2. Data Acess layer \n\nDefines the JSON-RPC 2 semantic, defining the structure of tools, resources \nand prompts as well as the lifecycle and session",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "PsFgemYPsvJNJUKE0gAbn",
      "type": "text",
      "x": -393.71884940040763,
      "y": 4822.976729963797,
      "width": 738.5341796875,
      "height": 87.94324831253834,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0i",
      "roundness": null,
